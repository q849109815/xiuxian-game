  "scenes": [
   {
    "who": "韩立",
    "face": "🧙",
    "text": "后山捡的这瓶子……夜里竟会渗出绿液？"
   },
   {
    "who": "旁白",
    "face": "📜",
    "text": "一滴绿液落在灵草上，原本需十年才成熟的三叶青，一夜之间便抽了新芽。"
   },
   {
    "who": "韩立",
    "face": "🧙",
    "text": "（心脏狂跳）此物……不可让第二人知晓。"
   },
   {
    "who": "旁白",
    "face": "📜",
    "text": "你悄悄将小瓶收进怀里。自此，掌天瓶成了你最大的秘密。"
   }
  ],
  "reward": {
   "stone": 630,
   "exp": 2700,
   "herb": 2,
   "ore": 1
  },
  "idx": 1

[
 {
  "id": "Q-M001",
  "chapter": "七玄门篇",
  "title": "初入七玄门",
  "req": 0,
  "npc": "墨大夫",
  "face": "👴",
  "scenes": [
   {
    "who": "韩立",
    "face": "🧙",
    "text": "我叫韩立，青牛镇韩家三子。家里穷，爹把我送来七玄门，说是……能混口饭吃。"
   },
   {
    "who": "墨大夫",
    "face": "👴",
    "text": "（眯眼打量）骨龄十五，根骨平平。也罢，从今日起，你便跟我学些医术。"
   },
   {
    "who": "厉飞雨",
    "face": "📜",
    "text": "小子，我叫厉飞雨。这七玄门水深得很，往后有事找我。"
   },
   {
    "who": "墨大夫",
    "face": "👴",
    "text": "这是一卷《长春功》残篇。练不练得成，看你自己的造化。"
   }
  ],
  "reward": {
   "stone": 300,
   "exp": 1200,
   "herb": 2,
   "ore": 1
  },
  "idx": 0
 },
 {
